# Copy to .env. Never commit .env.

# --- Nimble (live web search). Required for the genuine live-web verification step.
NIMBLE_API_KEY=
# NIMBLE_BASE_URL=https://sdk.nimbleway.com/v2

# --- Tinybird. Leave empty to use the bundled Tinybird Local container.
# For Tinybird Cloud: set both, and `docker compose run tinybird-deploy` deploys the project there.
# TINYBIRD_HOST=https://api.us-east.aws.tinybird.co
# TINYBIRD_TOKEN=

# --- Liquid AI. Default: LFM2.5-1.2B-Instruct served locally by the `liquid` llama.cpp container.
# To use a hosted/event-provided OpenAI-compatible Liquid endpoint instead:
# LIQUID_BASE_URL=https://.../v1
# LIQUID_API_KEY=
# LIQUID_MODEL=LFM2.5-1.2B-Instruct
# Local model override (llama.cpp -hf repo:quant):
# LIQUID_HF_REPO=LiquidAI/LFM2.5-1.2B-Instruct-GGUF:Q8_0

# --- Demo pacing
# HB_STEP_DELAY=0.8      # seconds each agent step stays on screen
# HB_WATCH_INTERVAL=1.0  # seconds between Tinybird condition checks
