# Nimble — https://online.nimbleway.com (API key from account settings)
NIMBLE_API_KEY=""
# live: always call Nimble | replay: only use data/nimble_recordings | auto: live, fall back to last recording
NIMBLE_MODE=auto
# optional: route our local browser through Nimble's residential IPs (dashboard > Pipelines)
# NIMBLE_PROXY_URL=http://USER:PASS@ip.nimbleway.com:7000

# Tinybird — recorded traces go here too (see browser-use-loop/tinybird/README.md); the append-only token
TINYBIRD_TELEMETRY_ENABLED=false
TINYBIRD_TOKEN=""
TINYBIRD_HOST=https://api.tinybird.co
